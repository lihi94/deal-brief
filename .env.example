# Optional. When unset, Deal Brief still runs: checked-in sample memos render,
# and a live request builds a structured template labeled as not live AI.
# The key is read only on the server. Never expose it to the browser.
ANTHROPIC_API_KEY=

# Used only when ANTHROPIC_API_KEY is set. The model may rewrite sentences.
# It does not choose the stance, and a draft that adds a figure is discarded.
ANTHROPIC_MODEL=claude-haiku-4-5

# SEC EDGAR fair-access header. Format the SEC asks for: a name and an email.
# Override with your own contact if you fork this repo.
EDGAR_USER_AGENT=Deal Brief (lihi94) elihai94@gmail.com
